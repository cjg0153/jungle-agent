param(
    [Parameter(Mandatory=$true)]
    [string]$InputJsonPath
)

$ErrorActionPreference =
    "Stop"


# ================================================================
# JUNGLE_SMART_PPT_REFLOW_WORKER_V3
#
# JUNGLE_SMART_REFLOW_WORKER_PROTOCOL_V2
# JUNGLE_SMART_REFLOW_HARD_GATE_WIRING_V1
#
# LIVE FLOW
#
# 1. REFLOW Executor
# 2. Mutation Boundary
# 3. Changed Scope
# 4. Selective Visual QA decision
# 5. Blind Pairwise regression QA
# 6. Existing PPT Visual Re-QA scorer
# 7. Test-JungleHardGate
#
# Fail closed:
# rejected changed artifacts are deleted.
# ================================================================


function Get-JungleWorkerStringSha256 {

    param(
        [Parameter(Mandatory=$true)]
        [AllowEmptyString()]
        [string]$Text
    )


    $encoding =
        New-Object System.Text.UTF8Encoding(
            $false
        )


    $bytes =
        $encoding.GetBytes(
            $Text
        )


    $sha =
        [System.Security.Cryptography.SHA256]::Create()


    try {

        $hashBytes =
            $sha.ComputeHash(
                $bytes
            )
    }
    finally {

        $sha.Dispose()
    }


    return (
        -join (
            $hashBytes |
            ForEach-Object {

                $_.ToString("x2")
            }
        )
    ).ToUpperInvariant()
}


function Write-JungleReflowWorkerResult {

    param(
        [Parameter(Mandatory=$true)]
        [string]$Path,

        [Parameter(Mandatory=$true)]
        [object]$Result
    )


    $encoding =
        New-Object System.Text.UTF8Encoding(
            $false
        )


    $json =
        $Result |
        ConvertTo-Json -Depth 15


    [System.IO.File]::WriteAllText(
        $Path,
        $json,
        $encoding
    )
}


function Remove-JungleRejectedArtifact {

    param(
        [string]$SourcePath,

        [string]$ArtifactPath
    )


    if (
        [string]::IsNullOrWhiteSpace(
            $ArtifactPath
        )
    ) {

        return
    }


    if (-not (
        Test-Path `
            -LiteralPath $ArtifactPath `
            -PathType Leaf
    )) {

        return
    }


    $sourceFull =
        [System.IO.Path]::GetFullPath(
            $SourcePath
        )


    $artifactFull =
        [System.IO.Path]::GetFullPath(
            $ArtifactPath
        )


    if (
        [string]::Equals(
            $sourceFull,
            $artifactFull,
            [System.StringComparison]::OrdinalIgnoreCase
        )
    ) {

        throw (
            "REFLOW safety refused to delete source presentation."
        )
    }


    Remove-Item `
        -LiteralPath $ArtifactPath `
        -Force
}


$resultPath =
    $null


$artifactPath =
    $null


$sourcePath =
    $null


try {

    # ============================================================
    # 1. INPUT
    # ============================================================

    if (-not (
        Test-Path `
            -LiteralPath $InputJsonPath `
            -PathType Leaf
    )) {

        throw (
            "REFLOW worker input missing: " +
            $InputJsonPath
        )
    }


    $inputText =
        [System.IO.File]::ReadAllText(
            $InputJsonPath
        )


    $inputData =
        $inputText |
        ConvertFrom-Json


    if (
        [string]$inputData.protocol -ne
        "JUNGLE_SMART_REFLOW_WORKER_PROTOCOL_V2"
    ) {

        throw (
            "Invalid REFLOW Worker Protocol."
        )
    }


    $resultPath =
        [string]$inputData.result_path


    if (
        [string]::IsNullOrWhiteSpace(
            $resultPath
        )
    ) {

        throw (
            "Worker result path missing."
        )
    }


    $request =
        [string]$inputData.request


    $expectedRequestHash =
        [string]$inputData.request_sha256


    $actualRequestHash =
        Get-JungleWorkerStringSha256 `
            -Text $request


    if (
        $actualRequestHash -ne
        $expectedRequestHash
    ) {

        throw (
            "REFLOW worker request SHA256 mismatch."
        )
    }


    $configPath =
        [string]$inputData.config_path


    $executorPath =
        [string]$inputData.executor_path


    $guardPath =
        [string]$inputData.guard_path


    $dryRun =
        [bool]$inputData.dry_run


    # ============================================================
    # 2. ROOT / DEPENDENCIES
    # ============================================================

    $root =
        Split-Path `
            -Parent (
                Split-Path `
                    -Parent $MyInvocation.MyCommand.Path
            )


    $changedScopePath =
        Join-Path `
            $root `
            "modules\changed_scope.ps1"


    $selectiveQaPath =
        Join-Path `
            $root `
            "modules\selective_visual_qa.ps1"


    $blindQaPath =
        Join-Path `
            $root `
            "modules\blind_pairwise_qa.ps1"


    $verifierPath =
        Join-Path `
            $root `
            "modules\verifier.ps1"


    $reQaPath =
        "C:\AI\scripts\run_pptx_visual_reqa_v1.ps1"


    foreach ($file in @(
        $configPath,
        $executorPath,
        $guardPath,
        $changedScopePath,
        $selectiveQaPath,
        $blindQaPath,
        $verifierPath,
        $reQaPath
    )) {

        if (-not (
            Test-Path `
                -LiteralPath $file `
                -PathType Leaf
        )) {

            throw (
                "REFLOW dependency missing: " +
                $file
            )
        }
    }


    # ============================================================
    # 3. EXACT EXECUTOR / SCORER HASHES
    # ============================================================

    $expectedExecutorHash =
        "A4D23C3DC0F5ED8FE04740F0C94EADE423EA52581EDDA2C171682C8228566C55"


    $expectedReQaHash =
        "1FC6759EFEE0C208932E24D7EB8D4F53681F5D7A3238D6C0FB00B2ECC4EEEA6F"


    $actualExecutorHash =
        (
            Get-FileHash `
                -LiteralPath $executorPath `
                -Algorithm SHA256
        ).Hash


    $actualReQaHash =
        (
            Get-FileHash `
                -LiteralPath $reQaPath `
                -Algorithm SHA256
        ).Hash


    if (
        $actualExecutorHash -ne
        $expectedExecutorHash
    ) {

        throw (
            "REFLOW executor integrity failure."
        )
    }


    if (
        $actualReQaHash -ne
        $expectedReQaHash
    ) {

        throw (
            "PPT Visual Re-QA scorer integrity failure."
        )
    }


    # ============================================================
    # 4. CONFIG
    # ============================================================

    $config =
        Get-Content `
            -LiteralPath $configPath `
            -Raw |
        ConvertFrom-Json


    if (-not $config.feature_flags.reflow_v1) {

        throw (
            "REFLOW V1 feature flag is OFF."
        )
    }


    if (-not $config.policy.hard_gate_required) {

        throw (
            "REFLOW requires Hard Gate."
        )
    }


    # ============================================================
    # 5. SOURCE PATH
    # ============================================================

    $sourceMatch =
        [regex]::Match(
            $request,
            '(?i)(?:"(?<p>[A-Z]:\\[^"]+?\.pptx?)"|''(?<p>[A-Z]:\\[^'']+?\.pptx?)''|(?<p>[A-Z]:\\.*?\.pptx?)(?=\s|$))'
        )


    if (-not $sourceMatch.Success) {

        throw (
            "REFLOW worker could not resolve source PPT path."
        )
    }


    $sourcePath =
        [string]$sourceMatch.Groups["p"].Value


    if (-not (
        Test-Path `
            -LiteralPath $sourcePath `
            -PathType Leaf
    )) {

        throw (
            "REFLOW source PPT missing: " +
            $sourcePath
        )
    }


    $sourceHashBefore =
        (
            Get-FileHash `
                -LiteralPath $sourcePath `
                -Algorithm SHA256
        ).Hash


    # ============================================================
    # 6. LOAD LOCAL QA MODULES
    # ============================================================

    . $guardPath
    . $changedScopePath
    . $selectiveQaPath
    . $blindQaPath
    . $verifierPath


    # ============================================================
    # 7. DRY RUN
    # ============================================================

    if ($dryRun) {

        $gate85 =
            Test-JungleHardGate `
                -Score 85 `
                -Critical 0 `
                -Major 0


        $gate84 =
            Test-JungleHardGate `
                -Score 84 `
                -Critical 0 `
                -Major 0


        $gateCritical =
            Test-JungleHardGate `
                -Score 95 `
                -Critical 1 `
                -Major 0


        $gateMajor =
            Test-JungleHardGate `
                -Score 95 `
                -Critical 0 `
                -Major 1


        if (
            -not $gate85 `
            -or
            $gate84 `
            -or
            $gateCritical `
            -or
            $gateMajor
        ) {

            throw (
                "Hard Gate deterministic self-test failed."
            )
        }


        $dryResult =
            [ordered]@{

                protocol =
                    "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

                status =
                    "REFLOW_DRY_RUN_READY"

                accepted =
                    $true

                pipeline_complete =
                    $false

                executor_called =
                    $false

                ai_calls =
                    0

                com_calls =
                    0

                source_path =
                    $sourcePath

                source_sha256 =
                    $sourceHashBefore

                mutation_boundary =
                    "READY"

                changed_scope =
                    "READY"

                blind_pairwise =
                    "READY"

                visual_reqa =
                    "READY"

                hard_gate =
                    "READY"

                hard_gate_rule =
                    "score>=85;critical=0;major=0"
            }


        Write-JungleReflowWorkerResult `
            -Path $resultPath `
            -Result $dryResult


        Write-Host (
            "STATUS : JUNGLE_REFLOW_WORKER_DRY_RUN_READY"
        )


        exit 0
    }


    # ============================================================
    # 8. LIVE EXECUTION
    # ============================================================

    $runDirectory =
        Split-Path `
            -Parent $resultPath


    $executorLogPath =
        Join-Path `
            $runDirectory `
            "reflow_executor.log"


    $scopeDir =
        Join-Path `
            $runDirectory `
            "changed_scope"


    $scopeJsonPath =
        Join-Path `
            $runDirectory `
            "changed_scope.json"


    $qaRequestPath =
        Join-Path `
            $runDirectory `
            "visual_qa_request.json"


    $blindQaDirectory =
        Join-Path `
            $runDirectory `
            "blind_pairwise_qa"


    $reQaOutputDirectory =
        Join-Path `
            $runDirectory `
            "visual_reqa_result"


    $reQaWorkRoot =
        Join-Path `
            $runDirectory `
            "visual_reqa_work"


    $reQaLogPath =
        Join-Path `
            $runDirectory `
            "visual_reqa.log"


    foreach ($dir in @(
        $scopeDir,
        $blindQaDirectory,
        $reQaOutputDirectory,
        $reQaWorkRoot
    )) {

        New-Item `
            -ItemType Directory `
            -Path $dir `
            -Force |
        Out-Null
    }


    # ------------------------------------------------------------
    # Snapshot output PPT paths before executor.
    # ------------------------------------------------------------

    $outputDirectory =
        "C:\AI\work\output"


    New-Item `
        -ItemType Directory `
        -Path $outputDirectory `
        -Force |
    Out-Null


    $beforeOutputPaths =
        @{}


    foreach (
        $file in
        @(
            Get-ChildItem `
                -LiteralPath $outputDirectory `
                -Filter "*.pptx" `
                -File
        )
    ) {

        $beforeOutputPaths[
            $file.FullName.ToLowerInvariant()
        ] =
            $true
    }


    # ============================================================
    # 9. REFLOW EXECUTOR
    # ============================================================

    $executorOutput =
        (
            & $executorPath `
                -FilePath $sourcePath `
                -UserRequest $request *>&1 |
            Out-String
        )


    [System.IO.File]::WriteAllText(
        $executorLogPath,
        $executorOutput,
        (
            New-Object System.Text.UTF8Encoding(
                $true
            )
        )
    )


    if (-not (
        [regex]::IsMatch(
            $executorOutput,
            '(?im)^\s*STATUS:\s*PPT_REFLOW_MODIFY_COMPLETE\s*$'
        )
    )) {

        throw (
            "REFLOW executor did not report COMPLETE."
        )
    }


    # ------------------------------------------------------------
    # Prefer authoritative File : path emitted by executor.
    # ------------------------------------------------------------

    $artifactMatch =
        [regex]::Match(
            $executorOutput,
            '(?im)^\s*File\s*:\s*(?<p>[A-Z]:\\[^\r\n]+?\.pptx)\s*$'
        )


    if ($artifactMatch.Success) {

        $artifactPath =
            [string]$artifactMatch.Groups["p"].Value
    }
    else {

        # --------------------------------------------------------
        # Fallback: FullName snapshot difference.
        # No LastWriteTime dependency.
        # --------------------------------------------------------

        $newCandidates =
            @(
                Get-ChildItem `
                    -LiteralPath $outputDirectory `
                    -Filter "*.pptx" `
                    -File |
                Where-Object {

                    -not $beforeOutputPaths.ContainsKey(
                        $_.FullName.ToLowerInvariant()
                    )
                }
            )


        if ($newCandidates.Count -ne 1) {

            throw (
                "REFLOW artifact discovery failed. New candidates=" +
                $newCandidates.Count
            )
        }


        $artifactPath =
            $newCandidates[0].FullName
    }


    if (-not (
        Test-JungleArtifact `
            -Path $artifactPath
    )) {

        throw (
            "REFLOW artifact validation failed."
        )
    }


    $sourceHashAfterExecutor =
        (
            Get-FileHash `
                -LiteralPath $sourcePath `
                -Algorithm SHA256
        ).Hash


    if (
        $sourceHashAfterExecutor -ne
        $sourceHashBefore
    ) {

        throw (
            "REFLOW source presentation changed."
        )
    }


    # ============================================================
    # 10. MUTATION BOUNDARY - SECOND ASSERTION
    #
    # Executor already performs it.
    # Worker independently asserts again.
    # ============================================================

    $mutationResult =
        Assert-JungleReflowMutationBoundary `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath `
            -SourceHashBefore $sourceHashBefore


    if (-not [bool]$mutationResult.passed) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "Worker Mutation Boundary failed."
        )
    }


    # ============================================================
    # 11. CHANGED SCOPE
    # ============================================================

    $scope =
        Get-JungleChangedScope `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath `
            -WorkDirectory $scopeDir


    $scope |
        ConvertTo-Json -Depth 10 |
        Set-Content `
            -LiteralPath $scopeJsonPath `
            -Encoding UTF8


    if (-not [bool]$scope.pass) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "REFLOW Changed Scope failed."
        )
    }


    # ============================================================
    # 12. NO VISUAL CHANGE
    #
    # Accepted only as NO-OP.
    # This is NOT a Hard Gate verified improvement.
    # ============================================================

    if (
        [bool]$scope.byte_identical `
        -or
        [int]$scope.changed_count -eq 0
    ) {

        $noOpResult =
            [ordered]@{

                protocol =
                    "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

                status =
                    "REFLOW_NOOP"

                accepted =
                    $true

                pipeline_complete =
                    $false

                hard_gate_passed =
                    $false

                hard_gate_state =
                    "SKIPPED_NO_VISUAL_CHANGE"

                source_path =
                    $sourcePath

                source_sha256 =
                    $sourceHashBefore

                artifact_path =
                    $artifactPath

                artifact_sha256 =
                    (
                        Get-FileHash `
                            -LiteralPath $artifactPath `
                            -Algorithm SHA256
                    ).Hash

                byte_identical =
                    [bool]$scope.byte_identical

                changed_count =
                    0

                changed_slides =
                    @()

                ai_calls =
                    (
                        [regex]::Matches(
                            $executorOutput,
                            '(?im)^\s*PPT_REFLOW_PLAN_CREATED\s*$'
                        )
                    ).Count

                message =
                    "REFLOW produced no visual change. Accepted only as NO-OP, not as verified improvement."
            }


        Write-JungleReflowWorkerResult `
            -Path $resultPath `
            -Result $noOpResult


        Write-Host (
            "STATUS : JUNGLE_REFLOW_NOOP"
        )


        exit 0
    }


    # ============================================================
    # 13. QA MUST BE ENABLED FOR CHANGED REFLOW
    # ============================================================

    if (-not $config.feature_flags.blind_pairwise_qa) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "REFLOW changed artifact requires Blind Pairwise QA."
        )
    }


    if (-not $config.visual_qa.live_execution) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "REFLOW changed artifact requires live Visual QA."
        )
    }


    # ============================================================
    # 14. SELECTIVE QA DECISION
    # ============================================================

    $maxSlidesPerCall =
        [int]$config.visual_qa.max_slides_per_call


    $qaDecision =
        Get-JungleSelectiveVisualQaDecision `
            -ChangedSlides @($scope.changed_slides) `
            -ByteIdentical ([bool]$scope.byte_identical) `
            -MaxSlidesPerCall $maxSlidesPerCall


    Write-JungleSelectiveVisualQaRequest `
        -Decision $qaDecision `
        -SourcePath $sourcePath `
        -ArtifactPath $artifactPath `
        -OutputPath $qaRequestPath |
    Out-Null


    if (-not [bool]$qaDecision.visual_qa_required) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "Changed REFLOW artifact unexpectedly skipped Visual QA."
        )
    }


    # ============================================================
    # 15. BLIND PAIRWISE REGRESSION GATE
    # ============================================================

    [int[]]$changedSlides =
        @(
            $scope.changed_slides |
            ForEach-Object {
                [int]$_
            }
        )


    $blindQa =
        Invoke-JungleBlindPairwiseVisualQa `
            -Root $root `
            -ChangedSlides $changedSlides `
            -ScopeDirectory $scopeDir `
            -ArtifactPath $artifactPath `
            -RunDirectory $blindQaDirectory `
            -TimeoutSeconds ([int]$config.visual_qa.timeout_seconds) `
            -PollMilliseconds ([int]$config.watchdog.poll_milliseconds)


    if (-not [bool]$blindQa.pass) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        $blindReject =
            [ordered]@{

                protocol =
                    "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

                status =
                    "REFLOW_PAIRWISE_REJECTED"

                accepted =
                    $false

                pipeline_complete =
                    $false

                artifact_removed =
                    $true

                changed_slides =
                    $changedSlides

                before_better_count =
                    [int]$blindQa.before_better_count

                critical_regressions =
                    [int]$blindQa.critical_regressions

                major_regressions =
                    [int]$blindQa.major_regressions

                hard_gate_state =
                    "NOT_REACHED"

                message =
                    "Blind Pairwise regression gate rejected REFLOW artifact."
            }


        Write-JungleReflowWorkerResult `
            -Path $resultPath `
            -Result $blindReject


        Write-Host (
            "STATUS : JUNGLE_REFLOW_PAIRWISE_REJECTED"
        )


        exit 4
    }


    # ============================================================
    # 16. EXISTING PPT VISUAL RE-QA SCORER
    #
    # This is the existing v3.2 scorer.
    # No new score formula is introduced.
    # ============================================================

    $reQaOutput =
        (
            & $reQaPath `
                -BeforePath $sourcePath `
                -AfterPath $artifactPath `
                -ChunkSize $maxSlidesPerCall `
                -OutputDir $reQaOutputDirectory `
                -WorkRoot $reQaWorkRoot *>&1 |
            Out-String
        )


    [System.IO.File]::WriteAllText(
        $reQaLogPath,
        $reQaOutput,
        (
            New-Object System.Text.UTF8Encoding(
                $true
            )
        )
    )


    if (-not (
        [regex]::IsMatch(
            $reQaOutput,
            '(?im)^\s*STATUS:\s*PPT_VISUAL_REQA_COMPLETE\s*$'
        )
    )) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "PPT Visual Re-QA did not report COMPLETE."
        )
    }


    $reQaFiles =
        @(
            Get-ChildItem `
                -LiteralPath $reQaOutputDirectory `
                -Filter "Jungle_PPT_Visual_ReQA_*.json" `
                -File
        )


    if ($reQaFiles.Count -ne 1) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        throw (
            "Expected exactly one PPT Visual Re-QA JSON. Found=" +
            $reQaFiles.Count
        )
    }


    $reQaJsonPath =
        $reQaFiles[0].FullName


    $visualQa =
        Get-Content `
            -LiteralPath $reQaJsonPath `
            -Raw |
        ConvertFrom-Json


    # ============================================================
    # 17. RESOLVE EXISTING SCORER'S AVERAGE SCORE
    #
    # Prefer persisted JSON if field is available.
    # Otherwise use scorer's own printed "Average score".
    #
    # No score is invented or inferred from Pairwise.
    # ============================================================

    $scoreValue =
        $null


    foreach ($propertyName in @(
        "score",
        "average_score",
        "average"
    )) {

        $property =
            $visualQa.PSObject.Properties[
                $propertyName
            ]


        if ($null -ne $property) {

            $scoreValue =
                [double]$property.Value

            break
        }
    }


    if ($null -eq $scoreValue) {

        $scoreMatch =
            [regex]::Match(
                $reQaOutput,
                '(?im)^\s*Average score\s*:\s*(?<n>[0-9]+(?:\.[0-9]+)?)\s*$'
            )


        if (-not $scoreMatch.Success) {

            Remove-JungleRejectedArtifact `
                -SourcePath $sourcePath `
                -ArtifactPath $artifactPath


            throw (
                "Could not resolve existing PPT Visual Re-QA score."
            )
        }


        $scoreValue =
            [double]$scoreMatch.Groups["n"].Value
    }


    $critical =
        [int]$visualQa.critical


    $major =
        [int]$visualQa.major


    $minor =
        [int]$visualQa.minor


    # ============================================================
    # 18. EXISTING HARD GATE
    #
    # Test-JungleHardGate requires integer Score.
    # Floor is conservative for decimal average scores.
    #
    # Exact double >= 85 is also required below.
    # ============================================================

    $gateIntegerScore =
        [int][Math]::Floor(
            [double]$scoreValue
        )


    $hardGateFunctionPass =
        Test-JungleHardGate `
            -Score $gateIntegerScore `
            -Critical $critical `
            -Major $major


    $exactScorePass =
        (
            [double]$scoreValue -ge 85
        )


    $visualScorerPass =
        [bool]$visualQa.pass


    $finalPass =
        (
            [bool]$blindQa.pass `
            -and
            $visualScorerPass `
            -and
            $hardGateFunctionPass `
            -and
            $exactScorePass
        )


    # ============================================================
    # 19. AI CALL ACCOUNTING
    # ============================================================

    $executorClaudeCalls =
        (
            [regex]::Matches(
                $executorOutput,
                '(?im)^\s*PPT_REFLOW_PLAN_CREATED\s*$'
            )
        ).Count


    $blindClaudeCalls =
        0


    if (
        $null -ne
        $blindQa.PSObject.Properties[
            "claude_calls"
        ]
    ) {

        $blindClaudeCalls =
            [int]$blindQa.claude_calls
    }


    $reQaClaudeCalls =
        (
            [regex]::Matches(
                $reQaOutput,
                '(?im)^\s*Chunk score\s*:'
            )
        ).Count


    $totalClaudeCalls =
        (
            $executorClaudeCalls +
            $blindClaudeCalls +
            $reQaClaudeCalls
        )


    # ============================================================
    # 20. HARD GATE REJECT
    # ============================================================

    if (-not $finalPass) {

        Remove-JungleRejectedArtifact `
            -SourcePath $sourcePath `
            -ArtifactPath $artifactPath


        $rejectResult =
            [ordered]@{

                protocol =
                    "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

                status =
                    "REFLOW_HARD_GATE_REJECTED"

                accepted =
                    $false

                pipeline_complete =
                    $false

                artifact_removed =
                    $true

                score =
                    [double]$scoreValue

                critical =
                    $critical

                major =
                    $major

                minor =
                    $minor

                hard_gate_required_score =
                    85

                hard_gate_passed =
                    $false

                blind_pairwise_passed =
                    [bool]$blindQa.pass

                visual_reqa_passed =
                    $visualScorerPass

                changed_count =
                    [int]$scope.changed_count

                changed_slides =
                    $changedSlides

                claude_calls =
                    $totalClaudeCalls

                visual_reqa_json =
                    $reQaJsonPath

                message =
                    "REFLOW artifact was deleted because the unchanged Hard Gate did not pass."
            }


        Write-JungleReflowWorkerResult `
            -Path $resultPath `
            -Result $rejectResult


        Write-Host (
            "STATUS : JUNGLE_REFLOW_HARD_GATE_REJECTED"
        )


        exit 5
    }


    # ============================================================
    # 21. VERIFIED
    # ============================================================

    $artifactHash =
        (
            Get-FileHash `
                -LiteralPath $artifactPath `
                -Algorithm SHA256
        ).Hash


    $verifiedResult =
        [ordered]@{

            protocol =
                "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

            status =
                "REFLOW_VERIFIED"

            accepted =
                $true

            pipeline_complete =
                $true

            source_path =
                $sourcePath

            source_sha256 =
                $sourceHashBefore

            artifact_path =
                $artifactPath

            artifact_sha256 =
                $artifactHash

            mutation_boundary =
                "PASS"

            changed_scope =
                "PASS"

            changed_count =
                [int]$scope.changed_count

            changed_slides =
                $changedSlides

            blind_pairwise =
                "PASS"

            before_better_count =
                [int]$blindQa.before_better_count

            critical_regressions =
                [int]$blindQa.critical_regressions

            major_regressions =
                [int]$blindQa.major_regressions

            score =
                [double]$scoreValue

            critical =
                $critical

            major =
                $major

            minor =
                $minor

            visual_reqa =
                "PASS"

            hard_gate_required_score =
                85

            hard_gate_passed =
                $true

            claude_calls =
                $totalClaudeCalls

            codex_calls =
                0

            executor_log =
                $executorLogPath

            changed_scope_json =
                $scopeJsonPath

            selective_qa_request =
                $qaRequestPath

            blind_pairwise_directory =
                $blindQaDirectory

            visual_reqa_json =
                $reQaJsonPath

            visual_reqa_log =
                $reQaLogPath
        }


    Write-JungleReflowWorkerResult `
        -Path $resultPath `
        -Result $verifiedResult


    Write-Host (
        "STATUS : JUNGLE_REFLOW_VERIFIED"
    )


    exit 0
}
catch {

    if (
        -not [string]::IsNullOrWhiteSpace(
            $artifactPath
        ) `
        -and
        -not [string]::IsNullOrWhiteSpace(
            $sourcePath
        )
    ) {

        try {

            Remove-JungleRejectedArtifact `
                -SourcePath $sourcePath `
                -ArtifactPath $artifactPath
        }
        catch {}
    }


    if (-not [string]::IsNullOrWhiteSpace(
        $resultPath
    )) {

        try {

            $failure =
                [ordered]@{

                    protocol =
                        "JUNGLE_SMART_REFLOW_WORKER_RESULT_V2"

                    status =
                        "FAIL"

                    accepted =
                        $false

                    pipeline_complete =
                        $false

                    artifact_removed =
                        $true

                    error =
                        $_.Exception.Message
                }


            Write-JungleReflowWorkerResult `
                -Path $resultPath `
                -Result $failure
        }
        catch {}
    }


    Write-Error $_.Exception.Message

    exit 1
}