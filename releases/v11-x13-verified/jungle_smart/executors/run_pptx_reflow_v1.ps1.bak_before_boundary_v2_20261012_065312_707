    $slideWidth =
        [double]$pres.PageSetup.SlideWidth

    $slideHeight =
        [double]$pres.PageSetup.SlideHeight

    if (
        $SlideLimit -gt 0 `
        -and $SlideLimit -lt $slideCount
    ) {

        $analysisCount =
