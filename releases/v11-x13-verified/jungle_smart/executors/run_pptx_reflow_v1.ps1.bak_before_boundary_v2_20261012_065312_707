$failed =
    @()


try {

    $ppt =
        New-Object -ComObject PowerPoint.Application

    $pres =
        $ppt.Presentations.Open(
            $outputPath,
            $false,
            $false,
            $false
        )


    if ([int]$pres.Slides.Count -ne $slideCount) {

        throw "Slide count changed before apply."
    }


        # JUNGLE_SMART_REFLOW_CREATED_SHAPE_REGISTRY_V1

        $createdShapes =
            @{}

    foreach ($op in $allOperations) {

        try {
                # =================================================
                # JUNGLE_SMART_REFLOW_ACTION_DISPATCH_V1
                # =================================================

                if (-not (
                    Has-PlanProperty `
                        $op `
                        "action"
                )) {

                    throw (
                        "REFLOW operation missing action."
                    )
                }


                $reflowAction =
                    (
                        [string]$op.action
                    ).ToLowerInvariant()


                if (-not (
                    Has-PlanProperty `
                        $op `
                        "slide_number"
                )) {

                    throw (
                        "REFLOW operation missing slide_number."
                    )
                }


                $reflowSlideNumber =
                    [int]$op.slide_number


                if (
                    $reflowSlideNumber -lt 1 `
                    -or
                    $reflowSlideNumber -gt [int]$pres.Slides.Count
                ) {

                    throw (
                        "Invalid REFLOW slide number."
                    )
                }


                # -------------------------------------------------
                # ADD DECORATIVE
                # -------------------------------------------------

                if (
                    $reflowAction -eq
                    "add_decorative"
                ) {

                    foreach ($requiredProperty in @(
                        "ref_id",
                        "shape_type",
                        "left",
                        "top",
                        "width",
                        "height"
                    )) {

                        if (-not (
                            Has-PlanProperty `
                                $op `
                                $requiredProperty
                        )) {

                            throw (
                                "add_decorative missing property: " +
                                $requiredProperty
                            )
                        }
                    }


                    $refId =
                        [string]$op.ref_id


                    if (
                        [string]::IsNullOrWhiteSpace(
                            $refId
                        )
                    ) {

                        throw (
                            "Decorative ref_id is empty."
                        )
                    }


                    if (
                        $createdShapes.ContainsKey(
                            $refId
                        )
                    ) {

                        throw (
                            "Duplicate decorative ref_id: " +
                            $refId
                        )
                    }


                    $shapeTypeName =
                        (
                            [string]$op.shape_type
                        ).ToLowerInvariant()


                    $shapeTypeCode =
                        0


                    switch ($shapeTypeName) {

                        "rectangle" {

                            $shapeTypeCode =
                                1
                        }


                        "rounded_rectangle" {

                            $shapeTypeCode =
                                5
                        }


                        "oval" {

                            $shapeTypeCode =
                                9
                        }


                        default {

                            throw (
                                "Unsupported decorative shape_type: " +
                                $shapeTypeName
                            )
                        }
                    }


                    $reflowSlide =
                        $pres.Slides.Item(
                            $reflowSlideNumber
                        )


                    $decorLeft =
                        [double]$op.left

                    $decorTop =
                        [double]$op.top

                    $decorWidth =
                        [double]$op.width

                    $decorHeight =
                        [double]$op.height


                    $decorLeft =
                        [Math]::Max(
                            0,
                            [Math]::Min(
                                $decorLeft,
                                $slideWidth - 5
                            )
                        )


                    $decorTop =
                        [Math]::Max(
                            0,
                            [Math]::Min(
                                $decorTop,
                                $slideHeight - 5
                            )
                        )


                    $decorWidth =
                        [Math]::Max(
                            5,
                            [Math]::Min(
                                $decorWidth,
                                $slideWidth - $decorLeft
                            )
                        )


                    $decorHeight =
                        [Math]::Max(
                            5,
                            [Math]::Min(
                                $decorHeight,
                                $slideHeight - $decorTop
                            )
                        )


                    $newShape =
                        $reflowSlide.Shapes.AddShape(
                            [int]$shapeTypeCode,
                            $decorLeft,
                            $decorTop,
                            $decorWidth,
                            $decorHeight
                        )


                    $safeRefName =
                        [regex]::Replace(
                            $refId,
                            '[^A-Za-z0-9_-]',
                            '_'
                        )


                    try {

                        $newShape.Name =
                            (
                                "JUNGLE_REFLOW_DECOR_" +
                                $safeRefName
                            )
                    }
                    catch {}


                    if (
                        Has-PlanProperty `
                            $op `
                            "fill_rgb"
                    ) {

                        try {

                            $newShape.Fill.Visible =
                                -1

                            $newShape.Fill.Solid()

                            $newShape.Fill.ForeColor.RGB =
                                [int]$op.fill_rgb


                            if (
                                Has-PlanProperty `
                                    $op `
                                    "fill_transparency"
                            ) {

                                $decorTransparency =
                                    [double]$op.fill_transparency


                                if (
                                    $decorTransparency -ge 0 `
                                    -and
                                    $decorTransparency -le 1
                                ) {

                                    $newShape.Fill.Transparency =
                                        $decorTransparency
                                }
                            }
                        }
                        catch {}
                    }


                    if (
                        Has-PlanProperty `
                            $op `
                            "line_visible"
                    ) {

                        if ([bool]$op.line_visible) {

                            $newShape.Line.Visible =
                                -1
                        }
                        else {

                            $newShape.Line.Visible =
                                0
                        }
                    }


                    if (
                        Has-PlanProperty `
                            $op `
                            "line_rgb"
                    ) {

                        try {

                            $newShape.Line.ForeColor.RGB =
                                [int]$op.line_rgb
                        }
                        catch {}
                    }


                    if (
                        Has-PlanProperty `
                            $op `
                            "line_weight"
                    ) {

                        try {

                            $decorLineWeight =
                                [double]$op.line_weight


                            if (
                                $decorLineWeight -ge 0.25 `
                                -and
                                $decorLineWeight -le 10
                            ) {

                                $newShape.Line.Weight =
                                    $decorLineWeight
                            }
                        }
                        catch {}
                    }


                    $createdShapes[$refId] =
                        [pscustomobject]@{

                            slide_number =
                                $reflowSlideNumber

                            shape =
                                $newShape
                        }


                    $applied++

                    continue
                }


                # -------------------------------------------------
                # Z ORDER
                # -------------------------------------------------

                if (
                    $reflowAction -eq
                    "z_order"
                ) {

                    $reflowSlide =
                        $pres.Slides.Item(
                            $reflowSlideNumber
                        )


                    $zTarget =
                        $null


                    if (
                        Has-PlanProperty `
                            $op `
                            "shape_id"
                    ) {

                        $zShapeId =
                            [int]$op.shape_id


                        $zTarget =
                            Get-ShapeById `
                                -Slide $reflowSlide `
                                -ShapeId $zShapeId
                    }
                    elseif (
                        Has-PlanProperty `
                            $op `
                            "ref_id"
                    ) {

                        $zRefId =
                            [string]$op.ref_id


                        if (-not (
                            $createdShapes.ContainsKey(
                                $zRefId
                            )
                        )) {

                            throw (
                                "Created decorative ref_id not found: " +
                                $zRefId
                            )
                        }


                        $createdInfo =
                            $createdShapes[$zRefId]


                        if (
                            [int]$createdInfo.slide_number -ne
                            $reflowSlideNumber
                        ) {

                            throw (
                                "Decorative ref_id belongs to another slide."
                            )
                        }


                        $zTarget =
                            $createdInfo.shape
                    }
                    else {

                        throw (
                            "z_order requires shape_id or ref_id."
                        )
                    }


                    if ($null -eq $zTarget) {

                        throw (
                            "Z-order target not found."
                        )
                    }


                    if (-not (
                        Has-PlanProperty `
                            $op `
                            "z_order"
                    )) {

                        throw (
                            "z_order command missing."
                        )
                    }


                    $zCommand =
                        (
                            [string]$op.z_order
                        ).ToLowerInvariant()


                    $zCode =
                        -1


                    switch ($zCommand) {

                        "bring_to_front" {

                            $zCode =
                                0
                        }


                        "send_to_back" {

                            $zCode =
                                1
                        }


                        "bring_forward" {

                            $zCode =
                                2
                        }


                        "send_backward" {

                            $zCode =
                                3
                        }


                        default {

                            throw (
                                "Invalid z_order command: " +
                                $zCommand
                            )
                        }
                    }


                    [void]$zTarget.ZOrder(
                        [int]$zCode
                    )


                    $applied++

                    continue
                }


                # -------------------------------------------------
                # DELETE CREATED
                #
                # Original presentation shapes are unreachable
                # from this delete path.
                # -------------------------------------------------

                if (
                    $reflowAction -eq
                    "delete_created"
                ) {

                    if (-not (
                        Has-PlanProperty `
                            $op `
                            "ref_id"
                    )) {

                        throw (
                            "delete_created requires ref_id."
                        )
                    }


                    $deleteRefId =
                        [string]$op.ref_id


                    if (-not (
                        $createdShapes.ContainsKey(
                            $deleteRefId
                        )
                    )) {

                        throw (
                            "delete_created may target only a decorative shape created earlier in this run."
                        )
                    }


                    $deleteInfo =
                        $createdShapes[$deleteRefId]


                    if (
                        [int]$deleteInfo.slide_number -ne
                        $reflowSlideNumber
                    ) {

                        throw (
                            "delete_created slide mismatch."
                        )
                    }


                    $deleteInfo.shape.Delete()


                    [void]$createdShapes.Remove(
                        $deleteRefId
                    )


                    $applied++

                    continue
                }


                # -------------------------------------------------
                # MODIFY EXISTING
                #
                # Falls through into proven SAFE executor logic.
                # -------------------------------------------------

                if (
                    $reflowAction -ne
                    "modify_existing"
                ) {

                    throw (
                        "Unsupported REFLOW action: " +
                        $reflowAction
                    )
                }


            $slideNumber =
                [int]$op.slide_number

            $shapeId =
                [int]$op.shape_id


            if (
                $slideNumber -lt 1 `
                -or $slideNumber -gt $analysisCount
            ) {

                throw "Invalid slide number"
            }


            $slide =
                $pres.Slides.Item(
                    $slideNumber
                )


            $shape =
                Get-ShapeById `
                    -Slide $slide `
                    -ShapeId $shapeId


            if ($null -eq $shape) {

                throw "Shape ID not found"
            }


            # ------------------------------------------------
            # Geometry
            # ------------------------------------------------

            $newLeft =
                [double]$shape.Left

            $newTop =
                [double]$shape.Top

            $newWidth =
                [double]$shape.Width

            $newHeight =
                [double]$shape.Height


            if (Has-PlanProperty $op "left") {

                $newLeft =
                    [double]$op.left
            }

            if (Has-PlanProperty $op "top") {

                $newTop =
                    [double]$op.top
            }

            if (Has-PlanProperty $op "width") {

                $newWidth =
                    [double]$op.width
            }

            if (Has-PlanProperty $op "height") {

                $newHeight =
                    [double]$op.height
            }


            $newWidth =
                [Math]::Max(
                    5,
                    [Math]::Min(
                        $newWidth,
                        $slideWidth
                    )
                )

            $newHeight =
                [Math]::Max(
                    5,
                    [Math]::Min(
                        $newHeight,
                        $slideHeight
                    )
                )

            $newLeft =
                [Math]::Max(
                    0,
                    [Math]::Min(
                        $newLeft,
                        $slideWidth - $newWidth
                    )
                )

            $newTop =
                [Math]::Max(
                    0,
                    [Math]::Min(
                        $newTop,
                        $slideHeight - $newHeight
                    )
                )


            if (Has-PlanProperty $op "left") {
                $shape.Left = $newLeft
            }

            if (Has-PlanProperty $op "top") {
                $shape.Top = $newTop
            }

            if (Has-PlanProperty $op "width") {
                $shape.Width = $newWidth
            }

            if (Has-PlanProperty $op "height") {
                $shape.Height = $newHeight
            }


            # ------------------------------------------------
            # Text style
            # ------------------------------------------------

            if (
                $shape.HasTextFrame -eq -1 `
                -and $shape.TextFrame.HasText -eq -1
            ) {

                $tr =
                    $shape.TextFrame.TextRange


                if (Has-PlanProperty $op "font_size") {

                    $fontSize =
                        [double]$op.font_size

                    if (
                        $fontSize -ge 7 `
                        -and $fontSize -le 72
                    ) {

                        $tr.Font.Size =
                            $fontSize
                    }
                }


                if (Has-PlanProperty $op "font_bold") {

                    if ([bool]$op.font_bold) {

                        $tr.Font.Bold =
                            -1
                    }
                    else {

                        $tr.Font.Bold =
                            0
                    }
                }


                if (Has-PlanProperty $op "font_rgb") {

                    $tr.Font.Color.RGB =
                        [int]$op.font_rgb
                }


                if (Has-PlanProperty $op "alignment") {

                    $alignment =
                        [int]$op.alignment

                    if (
                        $alignment -ge 1 `
                        -and $alignment -le 4
                    ) {

                        $tr.ParagraphFormat.Alignment =
                            $alignment
                    }
                }


                if (Has-PlanProperty $op "margin_left") {

                    $shape.TextFrame.MarginLeft =
                        [double]$op.margin_left
                }

                if (Has-PlanProperty $op "margin_right") {

                    $shape.TextFrame.MarginRight =
                        [double]$op.margin_right
                }

                if (Has-PlanProperty $op "margin_top") {

                    $shape.TextFrame.MarginTop =
                        [double]$op.margin_top
                }

                if (Has-PlanProperty $op "margin_bottom") {

                    $shape.TextFrame.MarginBottom =
                        [double]$op.margin_bottom
                }
            }


            # ------------------------------------------------
            # Fill style
            # ------------------------------------------------

            if (Has-PlanProperty $op "fill_rgb") {

                try {

                    $shape.Fill.Visible =
                        -1

                    $shape.Fill.Solid()

                    $shape.Fill.ForeColor.RGB =
                        [int]$op.fill_rgb

                    if (Has-PlanProperty $op "fill_transparency") {

                        $transparency =
                            [double]$op.fill_transparency

                        if (
                            $transparency -ge 0 `
                            -and $transparency -le 1
                        ) {

                            $shape.Fill.Transparency =
                                $transparency
                        }
                    }
                }
                catch {}
            }


            # ------------------------------------------------
            # Line style
            # ------------------------------------------------

            if (Has-PlanProperty $op "line_visible") {

                if ([bool]$op.line_visible) {

                    $shape.Line.Visible =
                        -1
                }
                else {

                    $shape.Line.Visible =
                        0
                }
            }


            if (Has-PlanProperty $op "line_rgb") {

                try {

                    $shape.Line.ForeColor.RGB =
                        [int]$op.line_rgb
                }
                catch {}
            }


            if (Has-PlanProperty $op "line_weight") {

                try {

                    $weight =
                        [double]$op.line_weight

                    if (
                        $weight -ge 0.25 `
                        -and $weight -le 10
                    ) {

                        $shape.Line.Weight =
                            $weight
                    }
                }
                catch {}
            }


            $applied++
        }
        catch {

            $failed +=
                (
                    "Slide {0} / Shape {1} : {2}" `
                    -f `
                    $op.slide_number,
                    $op.shape_id,
                    $_.Exception.Message
                )
        }
    }


    $pres.Save()
}
finally {

    if ($null -ne $pres) {

        try {
            $pres.Close()
        }
        catch {}

        Release-ComObjectSafe $pres
    }

    if ($null -ne $ppt) {

        try {
            $ppt.Quit()
        }
        catch {}

        Release-ComObjectSafe $ppt
    }

    [GC]::Collect()
    [GC]::WaitForPendingFinalizers()
}


# ============================================================
    # ============================================================
    # JUNGLE_SMART_REFLOW_EXECUTOR_FAIL_CLOSED_V1
    # ============================================================

    if ($failed.Count -gt 0) {

        if (
            Test-Path `
                -LiteralPath $outputPath `
                -PathType Leaf
        ) {

            Remove-Item `
                -LiteralPath $outputPath `
                -Force
        }


        throw (
            "REFLOW apply failed closed. Failed operations=" +
            $failed.Count +
            " Details=" +
            (
                $failed -join
                " | "
            )
        )
    }


    # ============================================================
    # JUNGLE_SMART_REFLOW_EXECUTOR_MUTATION_GUARD_V1
    # ============================================================

    try {

        $mutationBoundaryResult =
            Assert-JungleReflowMutationBoundary `
                -SourcePath $FilePath `
                -ArtifactPath $outputPath `
                -SourceHashBefore $sourceHashBefore
    }
    catch {

        if (
            Test-Path `
                -LiteralPath $outputPath `
                -PathType Leaf
        ) {

            Remove-Item `
                -LiteralPath $outputPath `
                -Force
        }


        throw (
            "REFLOW Mutation Boundary rejected artifact: " +
            $_.Exception.Message
        )
    }


    if (-not [bool]$mutationBoundaryResult.passed) {

        if (
            Test-Path `
                -LiteralPath $outputPath `
                -PathType Leaf
        ) {

            Remove-Item `
                -LiteralPath $outputPath `
                -Force
        }


        throw (
            "REFLOW Mutation Boundary returned non-pass result."
        )
    }

# 7. Validate output
# ============================================================

if (-not (Test-Path -LiteralPath $outputPath -PathType Leaf)) {

    throw "Visual PPTX was not created."
}


$outputInfo =
    Get-Item -LiteralPath $outputPath


if ($outputInfo.Length -lt 10000) {

    throw "Generated PPTX is unexpectedly small."
}


Write-Host ""
Write-Host "========================================"
Write-Host " JUNGLE PPT VISUAL MODIFY RESULT"
Write-Host "========================================"
Write-Host ""

Write-Host "REFLOW Modify : OK"
Write-Host "Slides total  :" $slideCount
Write-Host "Slides edited :" $analysisCount
Write-Host "Operations    :" $allOperations.Count
Write-Host "Applied       :" $applied
Write-Host "Failed        :" $failed.Count
Write-Host "Original      :" $FilePath
Write-Host "File          :" $outputPath
Write-Host "Size          :" $outputInfo.Length
Write-Host "Plan          :" $combinedPlanPath

if ($failed.Count -gt 0) {

    Write-Host ""
    Write-Host "Failed operations:"

    foreach ($item in $failed) {

        Write-Host " -" $item
    }
}


if ($failed.Count -eq 0) {

    Write-Host ""
    Write-Host "STATUS: PPT_REFLOW_MODIFY_COMPLETE"
}
else {

    Write-Host ""
    Write-Host "STATUS: PPT_REFLOW_MODIFY_PARTIAL"
}