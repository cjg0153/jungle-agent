if ($ext -notin @(".ppt",".pptx")) {
    throw "Only PPT/PPTX is supported."
}

if ($ChunkSize -lt 1) {
    throw "ChunkSize must be >= 1."
}

foreach ($dir in @(
    $outputDir,
    $tempDir
)) {

    if (-not (Test-Path -LiteralPath $dir)) {

        New-Item `
            -ItemType Directory `
            -Path $dir `
            -Force |
            Out-Null
    }
}


# ============================================================
# 2. Paths
# ============================================================

