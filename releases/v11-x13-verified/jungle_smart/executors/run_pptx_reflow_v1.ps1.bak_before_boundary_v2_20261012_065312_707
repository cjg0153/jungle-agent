# ============================================================
# 5. Claude visual planning - chunked
# ============================================================

$allOperations =
    @()

$chunkIndex =
    0


for (
    $chunkStart = 1;
    $chunkStart -le $analysisCount;
    $chunkStart += $ChunkSize
) {

    $chunkIndex++

    $chunkEnd =
        [Math]::Min(
